<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect provider (needed so the app can query / open it) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:resizeableActivity="true"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy rationale (Play requirement). Android 13 and below open it through this action. -->
        <activity
            android:name=".health.PermissionsRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/health_connect_rationale_title"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect rationale entry point for Android 14+ -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Alarm ring screen (supplements / workout). Opened by tapping the heads-up alarm notification; it can
             show over the lock screen and turn the screen on. It is not launched as a full-screen intent
             (USE_FULL_SCREEN_INTENT is intentionally not declared). -->
        <activity
            android:name=".alarms.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Alarms -->
        <receiver android:name=".alarms.AlarmReceiver" android:exported="false" />
        <receiver android:name=".alarms.ActionReceiver" android:exported="false" />
        <receiver android:name=".alarms.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Android 12+: granting / revoking SCHEDULE_EXACT_ALARM cancels our alarms; re-arm them. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget -->
        <receiver android:name=".widget.HabitWidgetProvider" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habit_widget_info" />
        </receiver>
    </application>

    <!--
        Permissions. FitSaathi is fully offline: it has no server, no account and no analytics, so it does not
        request INTERNET. Each permission below maps to one user-facing feature:

        POST_NOTIFICATIONS        Habit / water / fasting reminders, supplement and workout alarms, and the optional
                                  pinned "today's checklist" notification. Requested at runtime on Android 13+.
        SCHEDULE_EXACT_ALARM      Supplement and workout alarms ring at the minute the user chose. The user grants it
                                  in system settings (Android 12+); when denied the app silently falls back to
                                  inexact alarms (a 10-minute window).
        RECEIVE_BOOT_COMPLETED    Re-arm the user's alarms after a reboot or app update (AlarmManager drops them).
        VIBRATE                   Vibration pattern for alarms and the alarm ring screen.
        WAKE_LOCK                 Short (max 10 s) partial wake lock in AlarmReceiver so a fired alarm's notification is
                                  posted and the next occurrence re-armed before a dozing device sleeps again.
        USE_BIOMETRIC             Optional fingerprint / face unlock of the app (PIN stays the fallback).
        CAMERA                    Optional progress photos taken with the camera; stored encrypted on the device.
                                  Picking from the gallery uses the system photo picker and needs no storage permission.
        health.READ_STEPS         Read-only daily step count from Health Connect, shown on the Today / Progress tabs.
                                  Never written back, never uploaded (see PermissionsRationaleActivity / PRIVACY.md).

        Not declared on purpose: INTERNET (no network use), READ_EXTERNAL_STORAGE / READ_MEDIA_* (system picker),
        USE_FULL_SCREEN_INTENT (alarms use heads-up notifications that open the ring screen on tap).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
</manifest>
