{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fitsaathi.app/schema/profile.schema.json",
  "title": "FitSaathi Profile",
  "description": "User profile for FitSaathi. Import this JSON on first launch or from the Profile screen. All values belong to the user; nothing is hardcoded in the app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "age",
    "height",
    "currentWeightKg",
    "targetWeightKg",
    "activityLevel",
    "dietType",
    "fasting",
    "sleep",
    "waterTargetMl",
    "supplements",
    "workout",
    "appearanceGoals",
    "photoConsent"
  ],
  "definitions": {
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "24-hour time, HH:MM"
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "ISO weekday: 1 = Monday ... 7 = Sunday"
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "age": { "type": "integer", "minimum": 10, "maximum": 120 },
    "sex": { "type": "string", "enum": ["male", "female", "other"] },
    "city": { "type": "string", "maxLength": 80 },
    "height": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0, "description": "cm, or total inches when unit is ft_in" },
        "unit": { "type": "string", "enum": ["cm", "ft_in"] }
      }
    },
    "currentWeightKg": { "type": "number", "minimum": 20, "maximum": 400 },
    "targetWeightKg": { "type": "number", "minimum": 20, "maximum": 400 },
    "activityLevel": {
      "type": "string",
      "enum": ["sedentary", "light", "moderate", "active", "very_active"]
    },
    "dietType": {
      "type": "string",
      "enum": ["vegetarian", "eggetarian", "non_vegetarian", "vegan", "jain", "other"]
    },
    "fasting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "start", "end"],
      "properties": {
        "enabled": { "type": "boolean" },
        "start": { "$ref": "#/definitions/hhmm", "description": "Fast begins (eating window closes)" },
        "end": { "$ref": "#/definitions/hhmm", "description": "Fast ends (eating window opens)" }
      }
    },
    "sleep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/hhmm" },
        "end": { "$ref": "#/definitions/hhmm" }
      }
    },
    "waterTargetMl": { "type": "integer", "minimum": 250, "maximum": 10000 },
    "supplements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "dose", "time", "alarm"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "dose": { "type": "string", "maxLength": 80 },
          "time": { "$ref": "#/definitions/hhmm" },
          "alarm": { "type": "boolean" }
        }
      }
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": { "$ref": "#/definitions/hhmm" },
        "end": { "$ref": "#/definitions/hhmm" },
        "days": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/weekday" }
        }
      }
    },
    "appearanceGoals": { "type": "string", "maxLength": 2000 },
    "photoConsent": { "type": "boolean" },
    "nutritionTargets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kcal": { "type": "integer", "minimum": 800, "maximum": 8000 },
        "proteinG": { "type": "integer", "minimum": 20, "maximum": 400 }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weightUnit": { "type": "string", "enum": ["kg", "lb"] },
        "theme": { "type": "string", "enum": ["system", "light", "dark"] },
        "waterReminderIntervalMin": { "type": "integer", "minimum": 15, "maximum": 360 },
        "habitReminderTime": { "$ref": "#/definitions/hhmm" },
        "fastingNotifications": { "type": "boolean" },
        "waterReminders": { "type": "boolean" }
      }
    }
  }
}
