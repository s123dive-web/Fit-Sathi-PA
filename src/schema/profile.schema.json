{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fitsaathi.app/schema/profile.schema.json",
  "title": "FitSaathi Profile",
  "description": "User profile for FitSaathi. Import on first launch or from the Profile screen. All values belong to the user; nothing is hardcoded in the app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "user", "fasting", "sleep", "water", "workout", "supplements", "habits", "notifications", "privacy"],
  "definitions": {
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "24-hour time, HH:MM" },
    "dayName": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "age", "heightCm", "currentWeightKg", "targetWeightKg", "activityLevel", "dietType", "appearanceGoals"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "age": { "type": "integer", "minimum": 10, "maximum": 120 },
        "sex": { "type": "string", "enum": ["male", "female", "other"] },
        "city": { "type": "string", "maxLength": 80 },
        "heightCm": { "type": "number", "minimum": 100, "maximum": 250 },
        "currentWeightKg": { "type": "number", "minimum": 20, "maximum": 400 },
        "targetWeightKg": { "type": "number", "minimum": 20, "maximum": 400 },
        "activityLevel": { "type": "string", "enum": ["sedentary", "light", "moderate", "active", "very_active"] },
        "dietType": { "type": "string", "enum": ["veg", "egg", "non-veg", "vegan", "jain", "other"] },
        "cuisine": { "type": "string", "maxLength": 80 },
        "appearanceGoals": { "type": "string", "maxLength": 2000 }
      }
    },
    "fasting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "eatStart", "eatEnd"],
      "properties": {
        "enabled": { "type": "boolean" },
        "eatStart": { "$ref": "#/definitions/hhmm", "description": "Eating window opens (fast ends)" },
        "eatEnd": { "$ref": "#/definitions/hhmm", "description": "Eating window closes (fast begins)" }
      }
    },
    "sleep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bedtime", "wake"],
      "properties": { "bedtime": { "$ref": "#/definitions/hhmm" }, "wake": { "$ref": "#/definitions/hhmm" } }
    },
    "water": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetMl"],
      "properties": { "targetMl": { "type": "integer", "minimum": 250, "maximum": 10000 } }
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "start", "end", "days", "alarm"],
      "properties": {
        "enabled": { "type": "boolean" },
        "start": { "$ref": "#/definitions/hhmm" },
        "end": { "$ref": "#/definitions/hhmm" },
        "days": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/dayName" } },
        "location": { "type": "string", "maxLength": 80 },
        "alarm": { "type": "boolean", "description": "Exact alarm at workout start on workout days" }
      }
    },
    "supplements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dose", "time", "alarm"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Optional stable id; generated from name + time when absent" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "dose": { "type": "string", "maxLength": 80 },
          "time": { "$ref": "#/definitions/hhmm" },
          "alarm": { "type": "boolean" }
        }
      }
    },
    "habits": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schedule"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "schedule": { "type": "string", "enum": ["daily", "weekly", "weekdays"] },
          "targetPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
          "days": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/dayName" } },
          "emoji": { "type": "string", "maxLength": 8 },
          "reminder": { "$ref": "#/definitions/hhmm" }
        }
      }
    },
    "typicalMeals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakfast": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
        "lunch": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
        "dinner": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
        "snacks": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
        "protein": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chickenPerWeek": { "type": "number", "minimum": 0 },
            "fishPerWeek": { "type": "number", "minimum": 0 },
            "eggs": { "type": "string", "maxLength": 200 }
          }
        },
        "drinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "teaWithSugarCups": { "type": "number", "minimum": 0 }, "coffeeCups": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motivational", "fastingWarningMinutesBefore"],
      "properties": {
        "motivational": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "times"],
          "properties": {
            "enabled": { "type": "boolean" },
            "times": {
              "type": "array",
              "maxItems": 2,
              "items": { "$ref": "#/definitions/hhmm" },
              "description": "Up to 2 motivational notifications per day. The quote pool (64 lines) guarantees no repeated quote within a 14-day window for at most 2 slots per day."
            }
          }
        },
        "fastingWarningMinutesBefore": { "type": "integer", "minimum": 0, "maximum": 240 },
        "supplementAlarms": { "type": "boolean" },
        "workoutAlarm": { "type": "boolean" },
        "habitReminders": { "type": "boolean" },
        "eveningCheckIn": { "anyOf": [{ "$ref": "#/definitions/hhmm" }, { "type": "null" }] },
        "waterReminders": { "type": "boolean" },
        "waterReminderIntervalMin": { "type": "integer", "minimum": 15, "maximum": 360 },
        "fastingWindow": { "type": "boolean" },
        "pinnedChecklist": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photoConsent", "driveBackup", "futureLookCloud"],
      "properties": {
        "photoConsent": { "type": "boolean" },
        "driveBackup": { "type": "boolean" },
        "futureLookCloud": { "type": "boolean", "description": "v2 opt-in: would send a photo to a cloud image service. Default false." }
      }
    },
    "nutritionTargets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kcal": { "type": "integer", "minimum": 800, "maximum": 8000 },
        "proteinG": { "type": "integer", "minimum": 20, "maximum": 400 }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heightUnit": { "type": "string", "enum": ["cm", "ft_in"] },
        "weightUnit": { "type": "string", "enum": ["kg", "lb"] },
        "theme": { "type": "string", "enum": ["system", "light", "dark"] }
      }
    }
  }
}
